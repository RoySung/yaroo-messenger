{
  "name": "@yaroo/chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @yaroo/chat-protocol build && tsx watch server.ts --dev",
    "build": "pnpm --filter @yaroo/chat-protocol build && next build --webpack",
    "start": "tsx server.ts",
    "test": "pnpm --filter @yaroo/chat-protocol build && tsx --test server/chatServer.test.ts app/types/chatTypes.test.ts"
  },
  "dependencies": {
    "@yaroo/chat-protocol": "workspace:*",
    "@yaroo/ui": "workspace:*",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3"
  }
}
